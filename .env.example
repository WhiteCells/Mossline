# Runtime
APP_ENV=development
SERVER_ADDR=:8081
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=10s

# MySQL. DATABASE_URL, when set, overrides the individual DB_* values.
# DATABASE_URL=mossline:change-me@tcp(127.0.0.1:3306)/mossline?parseTime=true&loc=UTC
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mossline
DB_USER=mossline
DB_PASSWORD=change-me
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Optional first-run administrator. Remove these after the account is created.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password-123
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_SESSION_TTL=24h
AUTH_TOKEN_BYTES=32

# Local attachment storage
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
UPLOAD_PUBLIC_URL=/uploads
UPLOAD_MAX_BYTES=20971520
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain

# Browser origins used by Vite during local development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ALLOW_CREDENTIALS=false
