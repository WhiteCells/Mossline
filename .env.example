# 应用运行配置：宿主机 API 和容器 API 使用相同的 MOSSLINE_* 变量名
# 运行环境，可选 development、test、production
MOSSLINE_ENV=development
# 宿主机 API 监听地址；Compose 中固定为 :8081
MOSSLINE_HTTP_ADDR=:8081
# HTTP 请求读取、响应写入和优雅关闭超时，须携带时间单位
MOSSLINE_HTTP_READ_TIMEOUT=15s
MOSSLINE_HTTP_WRITE_TIMEOUT=30s
MOSSLINE_HTTP_SHUTDOWN_TIMEOUT=10s
# 可信反向代理网段，逗号分隔；留空表示不信任代理转发的客户端 IP
MOSSLINE_HTTP_TRUSTED_PROXY_CIDRS=

# 数据库：宿主机连接地址；容器内固定连接 mysql:3306
MOSSLINE_DATABASE_HOST=127.0.0.1
MOSSLINE_DATABASE_PORT=3306
# 库名、普通应用账号和密码同时用于 MySQL 首次初始化及 API 连接
# 应用账号不能为 root；已有数据卷的账号和密码不会随配置自动更改
MOSSLINE_DATABASE_NAME=mossline
MOSSLINE_DATABASE_USERNAME=mossline
MOSSLINE_DATABASE_PASSWORD=mossline-local-123
# 可选完整 MySQL DSN，宿主机 API 设置后优先于分项连接配置；Compose 中不使用
# 示例：mossline:change-me@tcp(127.0.0.1:3307)/mossline?parseTime=true&loc=UTC
MOSSLINE_DATABASE_DSN=
# 数据库连接字符集
MOSSLINE_DATABASE_CHARSET=utf8mb4
# 连接池最大打开数、最大空闲数，以及连接最长存活和空闲时间
MOSSLINE_DATABASE_MAX_OPEN_CONNS=25
MOSSLINE_DATABASE_MAX_IDLE_CONNS=10
MOSSLINE_DATABASE_CONN_MAX_LIFETIME=30m
MOSSLINE_DATABASE_CONN_MAX_IDLE_TIME=5m

# 首次管理员：仅在没有用户时创建，下面三项须同时设置或同时留空
# 已有用户时不会重置密码；创建后可清空这三项
MOSSLINE_BOOTSTRAP_ADMIN_USERNAME=admin
MOSSLINE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password-123
MOSSLINE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# 会话有效期与随机令牌字节数，令牌字节数至少为 32
MOSSLINE_AUTH_SESSION_TTL=24h
MOSSLINE_AUTH_TOKEN_BYTES=32

# 附件存储：当前仅支持 local，容器内固定使用 local
MOSSLINE_STORAGE_DRIVER=local
# 宿主机附件目录；容器内固定为 /app/data/uploads 并挂载持久化卷
MOSSLINE_STORAGE_LOCAL_DIR=./data/uploads
# 附件公开地址；改为其他本地路径时须同步修改 Nginx 代理规则
MOSSLINE_STORAGE_PUBLIC_URL=/uploads
# 单文件大小上限，单位字节；默认 20 MiB
MOSSLINE_STORAGE_MAX_UPLOAD_BYTES=20971520
# 允许上传的 MIME 类型，逗号分隔
MOSSLINE_STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain

# 跨域来源白名单，逗号分隔；默认允许两个 Vite 开发服务
MOSSLINE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# 是否允许跨域凭据；启用时来源白名单不能包含 *
MOSSLINE_CORS_ALLOW_CREDENTIALS=false

# Docker 专用配置：由 Compose 映射，不直接传给 API
# Go 镜像构建时的模块代理；可改为 https://proxy.golang.org,direct
MOSSLINE_DOCKER_GO_PROXY=https://goproxy.cn,direct
# MySQL root 密码，仅用于数据库首次初始化，不用于应用账号连接
MOSSLINE_DOCKER_MYSQL_ROOT_PASSWORD=root-local-123
# 宿主机端口绑定地址，127.0.0.1 仅本机可用，0.0.0.0 允许外部访问
MOSSLINE_DOCKER_BIND_IP=127.0.0.1
# MySQL、API、Web 映射到宿主机的端口；容器内分别为 3306、8081、80
MOSSLINE_DOCKER_MYSQL_HOST_PORT=3307
MOSSLINE_DOCKER_API_HOST_PORT=8081
MOSSLINE_DOCKER_WEB_HOST_PORT=8080
# Docker 等待 API 停机的时间，必须大于 MOSSLINE_HTTP_SHUTDOWN_TIMEOUT
MOSSLINE_DOCKER_API_STOP_GRACE_PERIOD=40s
